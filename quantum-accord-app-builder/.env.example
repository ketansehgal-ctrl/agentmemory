# Claude API key used to generate apps (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Model that writes the apps. Defaults to claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Expo access token for cloud builds (expo.dev > Account settings > Access tokens).
# Leave empty to run the studio with previews only; the Build button is then disabled.
EXPO_TOKEN=

# Expo account or organization that owns the client app projects (optional).
# EXPO_OWNER=quantumaccord

# Prefix for Android package names / iOS bundle IDs of generated apps.
# APP_ID_PREFIX=com.quantumaccord.apps

# Optional shared key. When set, every /api request must send it in the
# x-studio-key header (the web page asks for it once and remembers it).
# STUDIO_ACCESS_KEY=

# PORT=3000
# DATA_DIR=./data
# WORK_DIR=./work
